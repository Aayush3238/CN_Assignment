    {"name": "Trading", "hosts": 100, "vlan": 20, "site": "HQ"},
    {"name": "RemoteA-Users", "hosts": 80, "vlan": 30, "site": "RemoteA"},
    {"name": "RemoteB-Users", "hosts": 70, "vlan": 40, "site": "RemoteB"},
    {"name": "Colo", "hosts": 20, "vlan": 50, "site": "HQ"},
    {"name": "Link-HQ-RemoteA", "hosts": 2, "mode": "p2p30", "site": "HQ", "between": ["HQ", "RemoteA"]},
